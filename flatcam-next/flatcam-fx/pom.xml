<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.flatcam.next</groupId>
        <artifactId>flatcam-next</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>flatcam-fx</artifactId>
    <packaging>jar</packaging>

    <name>FlatCAM Next - FX</name>
    <description>
        JavaFX shell: window, menus, panels, theming. Fase 1 skeleton per
        CONTEXTO_FLATCAM_FX.md - no real viewport yet (Fase 2), no real
        Gerber/Excellon loading yet (Fase 3).
    </description>

    <properties>
        <javafx.mainClass>org.flatcam.fx.MainApp</javafx.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.flatcam.next</groupId>
            <artifactId>flatcam-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flatcam.next</groupId>
            <artifactId>flatcam-cam</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Optional theme family, alongside the hand-written CSS in resources/org/flatcam/fx/theme -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>2.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Reuse the legacy Python UI's own context-menu artwork. -->
            <resource>
                <directory>../../assets/resources</directory>
                <targetPath>org/flatcam/fx/icons</targetPath>
                <includes>
                    <include>replot32.png</include>
                    <include>clear_plot32.png</include>
                    <include>set_color32.png</include>
                    <include>cnc32.png</include>
                    <include>cnc16.png</include>
                    <include>source32.png</include>
                    <include>copy32.png</include>
                    <include>delete32.png</include>
                    <include>save_as.png</include>
                    <include>properties32.png</include>
                    <include>zoom_fit32.png</include>
                    <include>iso_16.png</include>
                    <include>cut32_bis.png</include>
                    <include>drilling_tool32.png</include>
                    <include>geometry16.png</include>
                    <include>flatcam_icon32.png</include>
                    <include>settings18.png</include>
                    <include>geometry32.png</include>
                    <include>eraser26.png</include>
                    <include>transform.png</include>
                    <include>rotate.png</include>
                    <include>skewX.png</include>
                    <include>skewY.png</include>
                    <include>flipx.png</include>
                    <include>flipy.png</include>
                    <include>reset32.png</include>
                    <include>edit_ok32.png</include>
                </includes>
            </resource>
            <resource>
                <directory>../../assets/resources/dark_resources</directory>
                <targetPath>org/flatcam/fx/icons/dark</targetPath>
                <includes>
                    <include>replot32.png</include>
                    <include>clear_plot32.png</include>
                    <include>set_color32.png</include>
                    <include>cnc32.png</include>
                    <include>cnc16.png</include>
                    <include>source32.png</include>
                    <include>copy32.png</include>
                    <include>delete32.png</include>
                    <include>save_as.png</include>
                    <include>properties32.png</include>
                    <include>zoom_fit32.png</include>
                    <include>iso_16.png</include>
                    <include>cut32_bis.png</include>
                    <include>drilling_tool32.png</include>
                    <include>flatcam_icon32.png</include>
                    <include>settings18.png</include>
                    <include>geometry32.png</include>
                    <include>eraser26.png</include>
                    <include>transform.png</include>
                    <include>rotate.png</include>
                    <include>skewX.png</include>
                    <include>skewY.png</include>
                    <include>flipx.png</include>
                    <include>flipy.png</include>
                    <include>reset32.png</include>
                    <include>edit_ok32.png</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${javafx.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
