<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.flatcam.next</groupId>
        <artifactId>flatcam-next</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>flatcam-fx</artifactId>
    <packaging>jar</packaging>

    <name>FlatCAM FX - UI</name>
    <description>
        JavaFX application with project tree, 2D viewport, Gerber/Excellon
        loading, CAM tool panels and the incremental Gerber editor.
    </description>

    <properties>
        <javafx.mainClass>org.flatcam.fx.FlatCamLauncher</javafx.mainClass>
        <flatcam.args></flatcam.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>0.11.7</version>
        </dependency>
        <dependency>
            <groupId>org.flatcam.next</groupId>
            <artifactId>flatcam-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flatcam.next</groupId>
            <artifactId>flatcam-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flatcam.next</groupId>
            <artifactId>flatcam-cam</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>../..</directory>
                <targetPath>org/flatcam/fx/about</targetPath>
                <includes><include>LICENSE</include></includes>
            </resource>
            <resource>
                <directory>src/main/filtered-resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The legacy toolbar/menu artwork is small (<1 MB for both themes).
                 Keep the full sets available as the JavaFX chrome is populated. -->
            <resource>
                <directory>../../assets/resources</directory>
                <targetPath>org/flatcam/fx/icons</targetPath>
                <includes>
                    <include>*.png</include>
                </includes>
            </resource>
            <resource>
                <directory>../../assets/resources/dark_resources</directory>
                <targetPath>org/flatcam/fx/icons/dark</targetPath>
                <includes>
                    <include>*.png</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Surefire loads JavaFX on the classpath, unlike the application launcher. -->
                    <argLine>--enable-native-access=ALL-UNNAMED ${argLine}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${javafx.mainClass}</mainClass>
                    <commandlineArgs>${flatcam.args}</commandlineArgs>
                    <options>
                        <option>--enable-native-access=javafx.graphics</option>
                        <!-- Optional read-only renderer bridge; keep in sync with the native launcher. -->
                        <option>--add-exports=javafx.graphics/com.sun.prism=ALL-UNNAMED</option>
                        <option>--add-exports=javafx.graphics/com.sun.javafx.tk=ALL-UNNAMED</option>
                        <option>--add-exports=javafx.graphics/com.sun.javafx.stage=ALL-UNNAMED</option>
                        <option>--add-exports=javafx.graphics/com.sun.javafx.tk.quantum=ALL-UNNAMED</option>
                        <option>--add-exports=javafx.graphics/com.sun.glass.ui=ALL-UNNAMED</option>
                        <!-- target already exists before the child JVM starts. Native launcher uses its session directory. -->
                        <option>-XX:ErrorFile=${project.build.directory}/hs_err_pid%p.log</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>windows-graphics-info</id>
            <activation><os><family>Windows</family></os></activation>
            <build><plugins><plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration><options combine.children="append">
                    <option>--add-opens=javafx.graphics/com.sun.prism.d3d=ALL-UNNAMED</option>
                </options></configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
