<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.flatcam.next</groupId>
        <artifactId>flatcam-next</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>flatcam-fx</artifactId>
    <packaging>jar</packaging>

    <name>FlatCAM Next - FX</name>
    <description>
        JavaFX shell: window, menus, panels, theming. Fase 1 skeleton per
        CONTEXTO_FLATCAM_FX.md - no real viewport yet (Fase 2), no real
        Gerber/Excellon loading yet (Fase 3).
    </description>

    <properties>
        <javafx.mainClass>org.flatcam.fx.MainApp</javafx.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.flatcam.next</groupId>
            <artifactId>flatcam-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flatcam.next</groupId>
            <artifactId>flatcam-cam</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Optional theme family, alongside the hand-written CSS in resources/org/flatcam/fx/theme -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>2.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The legacy toolbar/menu artwork is small (<1 MB for both themes).
                 Keep the full sets available as the JavaFX chrome is populated. -->
            <resource>
                <directory>../../assets/resources</directory>
                <targetPath>org/flatcam/fx/icons</targetPath>
                <includes>
                    <include>*.png</include>
                </includes>
            </resource>
            <resource>
                <directory>../../assets/resources/dark_resources</directory>
                <targetPath>org/flatcam/fx/icons/dark</targetPath>
                <includes>
                    <include>*.png</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${javafx.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
